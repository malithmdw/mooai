# Copy this file to `.env` and fill in real values.
# NEVER commit a populated `.env` file.
#
# Placeholders below are illustrative only — they are not valid credentials.
# ANTHROPIC_API_KEY / OPENAI_API_KEY / PINECONE_API_KEY / LANGSMITH_API_KEY
# may be left empty for APP_ENV=local; every other environment requires
# real values (enforced by src/core/config.py at startup).

# --- Application ---
APP_NAME=enterprise-ai-assistant
APP_ENV=local                          # local | dev | staging | prod
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=sk-ant-replace-me

# --- OpenAI (embeddings) ---
OPENAI_API_KEY=sk-replace-me

# --- Pinecone ---
PINECONE_API_KEY=pc-replace-me
PINECONE_INDEX_NAME=enterprise-knowledge
PINECONE_NAMESPACE=

# --- LangSmith observability ---
LANGSMITH_API_KEY=ls-replace-me
LANGSMITH_PROJECT=enterprise-ai-assistant
LANGSMITH_TRACING=true

# --- Data stores ---
POSTGRES_URL=postgresql+asyncpg://ai_assistant:change-me@localhost:5432/ai_assistant
REDIS_URL=redis://localhost:6379/0

# --- Rate limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Models ---
MODEL_NAME=claude-opus-5
EMBEDDING_MODEL=text-embedding-3-large
