# Copy this file to `.env` and fill in real values.
# NEVER commit a populated `.env` file.

# --- Application ---
APP_ENV=local                  # local | dev | staging | prod
APP_NAME=enterprise-ai-assistant
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# --- Hardcoded auth (POC only — replaced by Keycloak/OAuth later) ---
# Do not treat this as a real auth mechanism. See src/security/auth.py.
POC_AUTH_ENABLED=true
POC_ADMIN_USERNAME=admin
POC_ADMIN_PASSWORD=change-me

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- OpenAI (embeddings only) ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=enterprise-knowledge

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_assistant
POSTGRES_USER=ai_assistant
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://ai_assistant:change-me@localhost:5432/ai_assistant

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# --- MCP ---
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8765

# --- LangSmith observability ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-ai-assistant

# --- Streamlit ---
STREAMLIT_SERVER_PORT=8501
